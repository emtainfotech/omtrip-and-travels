# ==============================================================================
# OM Trip and Travels — Environment Configuration (.env)
# Copy this file to .env on your Hostinger server and update with your real values.
# ==============================================================================

APP_NAME="OM Trip and Travels"
APP_URL=https://yourdomain.com
APP_ENV=production
APP_DEBUG=false

# ------------------------------------------------------------------------------
# Hostinger MySQL Database Settings
# Found in: Hostinger hPanel -> Databases -> MySQL Databases
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_omtrip
DB_USER=u123456789_omtrip
DB_PASS=YourStrongDbPasswordHere

# ------------------------------------------------------------------------------
# Hostinger SMTP Mail Settings
# Found in: Hostinger hPanel -> Emails -> Email Accounts
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=bookings@yourdomain.com
SMTP_PASS=YourEmailAccountPassword
SMTP_FROM=bookings@yourdomain.com
ADMIN_NOTIFY_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# Business Contact (Used for Call Now & WhatsApp links)
# ------------------------------------------------------------------------------
WHATSAPP_NUMBER=919826012345
PHONE_NUMBER="+91 98260 12345"

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (Optional, leave blank if not used)
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
